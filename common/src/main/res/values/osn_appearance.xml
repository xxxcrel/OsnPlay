<resources>
    <color name="osn_background">#F3F6F3</color>
    <color name="osn_surface">#FFFFFF</color>
    <color name="osn_soft">#EDF2ED</color>
    <color name="osn_border">#DFE7DF</color>
    <color name="osn_accent">#157E43</color>
    <color name="osn_on_accent">#FFFFFF</color>
    <color name="osn_text">#17251D</color>
    <color name="osn_muted">#5B6D61</color>
    <color name="osn_tint">#E5F4E9</color>
    <color name="osn_warning">#926211</color>
    <style name="Theme.OsnPlay.Startup" parent="Theme.OsnPlay.Light" />
    <style name="Theme.OsnPlay.Light" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#157E43</item>
        <item name="android:colorControlNormal">#5B6D61</item>
        <item name="android:textColorPrimary">#17251D</item>
        <item name="android:textColorSecondary">#5B6D61</item>
        <item name="android:windowBackground">#F3F6F3</item>
        <item name="android:statusBarColor">#F3F6F3</item>
        <item name="android:navigationBarColor">#F3F6F3</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:alertDialogTheme">@style/Theme.OsnPlay.Light.Dialog</item>
    </style>
    <style name="Theme.OsnPlay.Light.Dialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#157E43</item>
        <item name="android:colorControlNormal">#5B6D61</item>
        <item name="android:colorControlActivated">#157E43</item>
        <item name="android:textColorPrimary">#17251D</item>
        <item name="android:textColorSecondary">#5B6D61</item>
        <item name="android:textColorHint">#5B6D61</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:windowBackground">#FFFFFF</item>
    </style>
    <style name="Theme.OsnPlay.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#64DF91</item>
        <item name="android:colorControlNormal">#A5B8AA</item>
        <item name="android:textColorPrimary">#EDF5EE</item>
        <item name="android:textColorSecondary">#A5B8AA</item>
        <item name="android:windowBackground">#111914</item>
        <item name="android:statusBarColor">#111914</item>
        <item name="android:navigationBarColor">#111914</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:alertDialogTheme">@style/Theme.OsnPlay.Dark.Dialog</item>
    </style>
    <style name="Theme.OsnPlay.Dark.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#64DF91</item>
        <item name="android:colorControlNormal">#A5B8AA</item>
        <item name="android:colorControlActivated">#64DF91</item>
        <item name="android:textColorPrimary">#EDF5EE</item>
        <item name="android:textColorSecondary">#A5B8AA</item>
        <item name="android:textColorHint">#A5B8AA</item>
        <item name="android:colorBackground">#1B251E</item>
        <item name="android:windowBackground">#1B251E</item>
    </style>
</resources>
